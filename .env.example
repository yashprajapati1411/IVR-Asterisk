# Sarvam AI API Key for Gujarati Speech-to-Text (STT) and Text-to-Speech (TTS)
SARVAM_API_KEY=your_sarvam_api_key_here

# Directory where Asterisk sound files reside
# For native Asterisk on Linux / Docker: /var/lib/asterisk/sounds/ivr
# For local development: leave empty to use ./sounds
ASTERISK_SOUNDS_DIR=
